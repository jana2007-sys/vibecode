# Copy to .env.local for local development, or set in your hosting provider
# (Render) as a build-time environment variable.
# Base URL of the FastAPI backend, including the /api prefix and WITHOUT a
# trailing slash.
#
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api
#
# Production (set in the host before building):
# VITE_API_URL=https://your-backend-url.onrender.com/api
#
# Note: VITE_API_BASE_URL is accepted as a legacy alias for the same value.
# Never put a Gemini API key or any other secret in frontend env vars — the
# backend is the only component that talks to Gemini.
