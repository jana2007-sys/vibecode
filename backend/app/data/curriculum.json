          "difficulty": "hard",
          "expects": ["schema flexibility", "scaling", "consistency"]
        },
        {
          "id": "db-008",
          "text": "How would you diagnose and fix a slow query?",
          "difficulty": "medium",
          "expects": ["explain plan", "index", "query plan"]
        },
        {
          "id": "db-009",
          "text": "What is the difference between a stored procedure and a view?",
