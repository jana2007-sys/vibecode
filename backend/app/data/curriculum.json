      "questions": [
        {
          "id": "db-001",
          "text": "Explain the differences between a primary key and a foreign key.",
          "difficulty": "easy",
          "expects": ["unique", "referential integrity", "relationship"]
        },
        {
          "id": "db-002",
          "text": "How does a B-tree index speed up query lookups?",
          "difficulty": "medium",
          "expects": ["logarithmic", "tree structure", "selectivity"]
        },
        {
          "id": "db-003",
          "text": "What is the difference between an inner join and a left join?",
          "difficulty": "easy",
          "expects": ["matching rows", "nulls", "join type"]
        },
        {
          "id": "db-004",
          "text": "What is an index and why does it matter for query performance?",
          "difficulty": "easy",
          "expects": ["lookup speed", "structure", "storage"]
