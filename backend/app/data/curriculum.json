        {
          "id": "py-010",
          "text": "How would you design a decorator that caches function results?",
          "difficulty": "hard",
          "expects": ["closure", "memoization", "cache key"]
        },
        {
          "id": "py-011",
          "text": "How do you unpack a tuple into separate variables in Python?",
          "difficulty": "easy",
          "expects": ["tuple unpacking", "multiple assignment", "sequence"]
