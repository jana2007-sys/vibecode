  "version": "1.0.0",
  "topics": [
    {
      "id": "topic-python",
      "title": "Python Fundamentals",
      "description": "Data structures, comprehensions, typing, and common idioms.",
      "weight": 1.2,
      "questions": [
        {
          "id": "py-001",
          "text": "Explain the difference between a list and a tuple in Python.",
          "difficulty": "easy",
          "expects": ["immutable", "mutable", "performance", "hashable"]
        },
        {
          "id": "py-002",
          "text": "Describe how Python's GIL affects multithreaded programs.",
          "difficulty": "hard",
          "expects": ["global interpreter lock", "thread safety", "io-bound", "cpu-bound"]
        },
        {
          "id": "py-003",
          "text": "What is the difference between a list and a dictionary in Python?",
          "difficulty": "easy",
          "expects": ["key-value pairs", "ordered", "lookup"]
        },
        {
          "id": "py-004",
          "text": "How do you handle exceptions in Python?",
          "difficulty": "easy",
          "expects": ["try", "except", "finally"]
        },
        {
          "id": "py-005",
          "text": "What is a decorator and how does it work?",
          "difficulty": "medium",
          "expects": ["higher-order function", "wrapper", "syntax sugar"]
        },
        {
          "id": "py-006",
          "text": "Explain the difference between the `is` operator and `==` in Python.",
          "difficulty": "medium",
          "expects": ["identity", "equality", "memory address"]
        },
        {
          "id": "py-007",
          "text": "How does Python's garbage collection work?",
          "difficulty": "medium",
          "expects": ["reference counting", "cycle detection", "generational"]
        },
        {
          "id": "py-008",
          "text": "Describe the differences between async/await and threads in Python.",
          "difficulty": "hard",
          "expects": ["event loop", "concurrency", "blocking"]
        },
        {
          "id": "py-009",
          "text": "What is a list comprehension and when would you use one?",
          "difficulty": "easy",
          "expects": ["concise", "construct", "readability"]
