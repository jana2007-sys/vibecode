          "difficulty": "medium",
          "expects": ["replication", "stale reads", "tradeoff"]
        },
        {
          "id": "sd-007",
          "text": "What is the difference between REST and GraphQL?",
          "difficulty": "easy",
          "expects": ["endpoints", "query flexibility", "overfetching"]
        },
        {
          "id": "sd-008",
          "text": "How would you scale a read-heavy web service?",
          "difficulty": "hard",
          "expects": ["caching", "read replicas", "load balancing"]
        },
        {
          "id": "sd-009",
          "text": "Design a message queue for decoupling two services.",
          "difficulty": "hard",
          "expects": ["producer", "consumer", "durability"]
        },
        {
          "id": "sd-010",
          "text": "What is a CDN and why would you use one?",
          "difficulty": "medium",
          "expects": ["edge caching", "latency", "distribution"]
        },
        {
          "id": "sd-011",
          "text": "What is the difference between synchronous and asynchronous communication?",
          "difficulty": "easy",
          "expects": ["blocking", "non-blocking", "response time"]
        },
        {
          "id": "sd-012",
          "text": "How would you design an API rate limiter?",
          "difficulty": "medium",
          "expects": ["token bucket", "quota", "client identity"]
        },
        {
          "id": "sd-013",
          "text": "Design a system that serves personalized recommendations at scale.",
          "difficulty": "hard",
          "expects": ["feature store", "caching", "batch pipeline"]
        }
      ]
