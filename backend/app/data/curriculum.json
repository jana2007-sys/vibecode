        {
          "id": "db-011",
          "text": "What is the difference between a primary key and a unique constraint?",
          "difficulty": "easy",
          "expects": ["primary key", "unique", "null"]
        },
        {
          "id": "db-012",
          "text": "How does database indexing affect INSERT and UPDATE performance?",
          "difficulty": "medium",
          "expects": ["index maintenance", "write amplification", "tradeoff"]
        },
        {
          "id": "db-013",
          "text": "How would you design a database to handle millions of writes per second?",
          "difficulty": "hard",
          "expects": ["sharding", "partitioning", "write throughput"]
        }
      ]
    },
    {
      "id": "topic-systems",
      "title": "System Design",
      "description": "Scalability, APIs, caching, and distributed systems basics.",
      "weight": 1.4,
      "questions": [
        {
          "id": "sd-001",
          "text": "Design a URL shortener. What are the key components?",
          "difficulty": "hard",
          "expects": ["hash function", "database", "caching", "load balancer"]
        },
        {
          "id": "sd-002",
          "text": "Explain what an API endpoint is.",
          "difficulty": "easy",
          "expects": ["http", "request", "response"]
        },
        {
          "id": "sd-003",
          "text": "What is the difference between horizontal and vertical scaling?",
          "difficulty": "easy",
          "expects": ["more machines", "more resources", "bottlenecks"]
        },
        {
          "id": "sd-004",
          "text": "How would you design a caching layer for a web application?",
          "difficulty": "medium",
          "expects": ["cache key", "eviction", "invalidation"]
        },
        {
          "id": "sd-005",
          "text": "How does a load balancer distribute traffic?",
          "difficulty": "medium",
          "expects": ["health checks", "algorithm", "availability"]
        },
        {
          "id": "sd-006",
