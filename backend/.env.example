# Copy to .env and adjust values for your local environment.
# NEVER commit your real .env — it holds secrets (Gemini API key, DB password).

# --- Runtime ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# --- Database ---
# Local development uses SQLite at DATABASE_PATH.
DATABASE_PATH=data/intervue.db
# Production: set DATABASE_URL to a PostgreSQL DSN (e.g.
# postgres://user:pass@host:5432/dbname). When set to a postgres:// URL the
# backend automatically uses PostgreSQL; otherwise SQLite is used.
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (set to your deployed frontend URL, e.g.):
# CORS_ORIGINS=https://your-frontend-url.onrender.com

# --- Gemini API (semantic answer evaluation) ---
# Set GEMINI_ENABLED=true and provide a key to layer AI scoring on top of the
# deterministic evaluator. When disabled (or on any AI error) scoring falls
# back to the deterministic heuristic, so the app works without a key.
# The key must exist ONLY in the backend deployment environment — never in the
# frontend, source code, or this repository.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AI verifier ensemble (multi-AI answer verification) ---
# Comma-separated Gemini model ids that independently verify EVERY answer
# before it is graded; the panel majority decides whether the answer is correct
# and the consensus determines the mark. Requires GEMINI_ENABLED=true. When
# empty, answers are scored by the single GEMINI_MODEL instead.
# Example: AI_VERIFIER_MODELS=gemini-2.0-flash,gemini-2.5-pro
AI_VERIFIER_MODELS=
# Minimum fraction of verifier AIs that must confirm an answer for it to count
# as correct (0.5 = majority, 1.0 = unanimous).
AI_VERIFIER_AGREEMENT=0.5
