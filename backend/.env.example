# Copy to .env and adjust values for your local environment.

# --- Runtime ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# --- Database ---
DATABASE_PATH=data/intervue.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Gemini API (future integration - DO NOT enable yet) ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
